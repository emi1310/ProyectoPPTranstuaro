<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Trastuaro_V2</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="View\FormInicio.cs" />
    <Compile Remove="View\FormInicio.Designer.cs" />
    <Compile Remove="View\FormSeleccionLiquidacion.cs" />
    <Compile Remove="View\FormSeleccionLiquidacion.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="View\FormInicio.resx" />
    <EmbeddedResource Remove="View\FormSeleccionLiquidacion.resx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.30" />
    <PackageReference Include="PDFsharp-GDI" Version="6.2.4" />
  </ItemGroup>

</Project>