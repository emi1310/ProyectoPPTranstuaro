  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.30" />
    <PackageReference Include="PDFsharp-GDI" Version="6.2.4" />
  </ItemGroup>

  <!-- Archivos de la versión anterior conservados en el repositorio. -->
  <ItemGroup>
    <Compile Remove="Controllers\ClienteController.cs.cs" />
    <Compile Remove="Controllers\LiquidacionMensualController.cs" />
