    <Compile Remove="Repositories\LiquidacionMensualRepository.cs" />
    <Compile Remove="Services\LiquidacionMensualService.cs" />
    <Compile Remove="View\FormLiquidacionDirecta.cs" />
    <Compile Remove="View\FormLiquidacionDirecta.Designer.cs" />
    <Compile Remove="View\FormLiquidaciones.cs" />
    <Compile Remove="View\FormLiquidaciones.Designer.cs" />
    <EmbeddedResource Remove="View\FormLiquidacionDirecta.resx" />
    <EmbeddedResource Remove="View\FormLiquidaciones.resx" />
  </ItemGroup>
</Project>